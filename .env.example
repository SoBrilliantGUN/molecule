# ===================== 环境变量模板（复制为 .env 后填写真实值）=====================

# ===== LLM（SiliconFlow，OpenAI 兼容接口，仅核验用）=====
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ===== DeepSeek 官方 API（主生成用，更快）=====
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 核验模型（跨家换脑，用于生成后核验；与主生成 DeepSeek 官方不同家）
# 注意：Qwen3-Coder-480B 在硅基流动已 403 禁用，故用 GLM-5.3
LLM_VERIFY_MODEL=zai-org/GLM-5.3
# 单文件 HTML 生成调 LLM 的超时（秒）。缺省 900。生成耗时若更长需调大。
LLM_GENERATE_TIMEOUT=900
# 生成后核验通过分数（默认 0.7）
VERIFY_PASS_SCORE=0.7
# 生成核验不通过后的重生成次数（默认 2）
REACT_MAX_RETRY=2
# 赛马候选模型（逗号分隔，走硅基流动；默认 2 路并行）
RACE_MODELS=deepseek-ai/DeepSeek-V4-Flash,Qwen/Qwen3-Coder-30B-A3B-Instruct
# LangGraph checkpoint 的 psycopg DSN（断点续跑；与主库同库，docker-compose 已拼好）
# 本地跑若没设此变量，会从 DATABASE_URL 剥掉 +asyncpg 推导
LANGGRAPH_CHECKPOINT_DSN=postgresql://atoms:change-me@localhost:5432/atoms

# ===== 数据库（PostgreSQL，docker-compose 会自动拼出 DATABASE_URL）=====
POSTGRES_USER=atoms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atoms

# ===== 应用 =====
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
