# ===================== 环境变量模板（复制为 .env 后填写真实值）=====================

# ===== LLM（SiliconFlow，OpenAI 兼容接口）=====
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 主生成模型（编码/工具编排）
LLM_MAIN_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 核验模型（跨家换脑，用于赛马打分/阶段核验）
LLM_VERIFY_MODEL=Qwen/Qwen3-Coder-480B-A35B-Instruct
# 意图识别模型
LLM_INTENT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 视觉模型（看预览截图，可选）
LLM_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
# 单文件 HTML 生成调 LLM 的超时（秒）。缺省 900。生成耗时若更长需调大。
LLM_GENERATE_TIMEOUT=900
# 长任务 DAG 分阶段生成的相关配置（详情见复刻计划）
# 复杂度分类模型（缺省复用 LLM_INTENT_MODEL）
LLM_CLASSIFY_MODEL=deepseek-ai/DeepSeek-V4-Flash
# DAG/阶段规划的模型（缺省复用 LLM_MAIN_MODEL）
LLM_PLAN_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 每个 DAG 节点的输出 token 上限（约 2000，越小单次调用越快越不易超时）
LLM_STAGE_STEP_TOKENS=2000
# DAG 最长串行链上限（默认 4）
DAG_MAX_CHAIN=4
# 阶段核验通过分数（默认 0.7）
VERIFY_PASS_SCORE=0.7
# DAG 规划重试上限（默认 3）
DAG_MAX_RETRY=3
# 短任务核验不通过后的重生成次数（默认 2）
REACT_MAX_RETRY=2

# ===== 数据库（PostgreSQL，docker-compose 会自动拼出 DATABASE_URL）=====
POSTGRES_USER=atoms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atoms

# ===== 应用 =====
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
