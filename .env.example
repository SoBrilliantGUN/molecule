# ===================== 环境变量模板（复制为 .env 后填写真实值）=====================

# ===== LLM（SiliconFlow，OpenAI 兼容接口）=====
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 主生成模型（编码/工具编排）
LLM_MAIN_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 核验模型（跨家换脑，用于赛马打分/阶段核验）
LLM_VERIFY_MODEL=Qwen/Qwen3-Coder-480B-A35B-Instruct
# 意图识别模型
LLM_INTENT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 视觉模型（看预览截图，可选）
LLM_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ===== 数据库（PostgreSQL，docker-compose 会自动拼出 DATABASE_URL）=====
POSTGRES_USER=atoms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atoms

# ===== 应用 =====
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
